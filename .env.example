NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_TU_LLAVE_PUBLICA

# --- Modulo Clinica (opcionales; la app degrada elegantemente sin ellos) ---

# URL publica del sitio (para el callback de Google OAuth y enlaces)
NEXT_PUBLIC_APP_URL=https://tu-dominio.vercel.app

# Service role de Supabase (solo servidor; requerido para Google Calendar)
SUPABASE_SECRET_KEY=

# Google Calendar (crear credenciales OAuth en Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resumenes de sesion con IA (Claude)
ANTHROPIC_API_KEY=
# Modelo opcional (default: claude-sonnet-5)
ANTHROPIC_MODEL=

# --- Modulo Cursos: area de estudiantes ---

# Llave para cifrar la contrasena que se le asigna a cada estudiante (para
# poder reimprimir su ficha de credenciales). Generarla una sola vez con:
#   openssl rand -base64 32
# y nunca cambiarla despues (perderla vuelve irrecuperables las contrasenas
# ya cifradas; en ese caso solo queda regenerarlas). Requerida para poder
# crear o gestionar estudiantes.
ESTUDIANTES_ENC_KEY=

# --- Telegram (opcional): avisos y control de la app desde un bot privado ---

# Token del bot: en Telegram habla con @BotFather, envia /newbot y copia el token.
TELEGRAM_BOT_TOKEN=
# Secreto que Telegram envia en cada llamada al webhook (1-256 caracteres
# A-Z a-z 0-9 _ -). Generarlo con:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Protege el resumen diario que dispara Vercel Cron (vercel.json). Vercel lo
# envia solo como "Authorization: Bearer <CRON_SECRET>". Generarlo igual.
CRON_SECRET=

# --- WhatsApp (opcional): recordatorio automatico de citas al paciente ---
# WhatsApp Business Platform (Cloud API). Todo queda apagado mientras falte
# cualquiera de las tres primeras. Ver README > "Recordatorio de citas por WhatsApp".

# "meta" (por defecto), "360dialog" o "ycloud". Con 360dialog o YCloud,
# WHATSAPP_TOKEN es la API key del proveedor y WHATSAPP_PHONE_NUMBER_ID no se usa.
WHATSAPP_PROVEEDOR=
# Solo YCloud: tu numero de WhatsApp Business con codigo de pais (+502...).
WHATSAPP_NUMERO=
# Solo YCloud: secret del endpoint de webhook (valida la cabecera YCloud-Signature).
WHATSAPP_WEBHOOK_SECRET=
# Token de acceso de un usuario del sistema de Meta Business (permanente).
WHATSAPP_TOKEN=
# Id del numero conectado (Meta > WhatsApp > Configuracion de la API), no el numero.
WHATSAPP_PHONE_NUMBER_ID=
# Nombre exacto de la plantilla aprobada (categoria Utilidad).
WHATSAPP_TEMPLATE_CITA=recordatorio_cita
# Idioma con el que se aprobo la plantilla (es, es_MX...).
WHATSAPP_TEMPLATE_IDIOMA=es
# Texto libre que se escribe tambien en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Secreto de la app de Meta (Configuracion basica): valida la firma de cada webhook.
WHATSAPP_APP_SECRET=
# Opcionales: version de la Graph API (por defecto v23.0) o la base propia de un proveedor.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_API_URL=

# --- Pagos de consultas con PayPal (opcional) ---
# Enlace de pago creado en PayPal (Pagos > Enlaces y botones de pago).
# www.juanjreyes.org/pagar redirige a este enlace. Vacio = el de la consulta
# (https://www.paypal.com/ncp/payment/H2EFVWPKMF49W).
PAYPAL_ENLACE_CONSULTA=
# App REST de developer.paypal.com (Apps & Credentials, modo Live) y el ID
# del webhook suscrito a https://www.juanjreyes.org/api/paypal/webhook con los
# eventos PAYMENT.CAPTURE.COMPLETED y PAYMENT.CAPTURE.REFUNDED. Con esto se
# verifica cada aviso antes de mandarlo a Telegram.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# "sandbox" para pruebas; vacio = live.
PAYPAL_ENV=
